generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                   @id @default(cuid())
  name               String
  email              String                   @unique
  password           String
  role               String                   @default("FRANCHISEE")
  city               String?
  cpfCnpj            String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  permissions        String                   @default("")
  slug               String?                  @unique
  storeAddress       String?
  storeBanner        String?
  storeName          String?
  storePhone         String?
  storeDeliveryOnly  Boolean                  @default(true)
  storeHours         Json?
  storeLogo          String?
  paymentFees        Json?
  deliveryZoneType   String?
  deliveryZones      Json?
  storeLatLng        Json?
  isFranqueadoHakim  Boolean                  @default(false)
  deliveryConfig     Json?
  cashOpen           Boolean                  @default(false)
  storeOpen          Boolean                  @default(true)
  storeCoupons       Json?
  storePause         Json?
  pagarmeRecipientId String?
  autoAcceptOrders   Boolean                  @default(false)
  facebookPixelId    String?
  storeAlertSound    String?                  @default("bell")
  storeLoyalty       Json?
  storeOrderCount    Int                      @default(0)
  resetToken         String?
  resetTokenExp      DateTime?
  printerConfig      Json?
  financialGoals     Json?
  fixedCosts         Json?
  planPercent        Float                    @default(0)
  metaAdAccountId    String?
  metaAdsEnabled     Boolean                  @default(false)
  metaFbAccessToken  String?
  metaFbPageId       String?
  metaPixelId        String?
  ifoodAccessToken   String?
  ifoodClientId      String?
  ifoodConnected     Boolean                  @default(false)
  ifoodMerchantId    String?
  celcoinAccountId   String?
  mpAccessToken      String?
  mpRefreshToken     String?
  mpSellerId         String?
  customerOrders     CustomerOrder[]
  billingCycles      FranchiseeBillingCycle[]
  kitchenItems       KitchenItem[]
  menuProducts       MenuProduct[]
  metaAdsCampaigns   MetaAdsCampaign[]
  motoboys           Motoboy[]
  orders             Order[]
  storeReviews       StoreReview[]
}

model Product {
  id            String      @id @default(cuid())
  name          String
  description   String
  price         Float
  imageUrl      String?
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  category      String?
  labelData     Json?
  franchiseOnly Boolean     @default(false)
  orderItems    OrderItem[]
}

model Order {
  id              String         @id @default(cuid())
  userId          String
  totalAmount     Float
  status          String         @default("PENDING_PAYMENT")
  boletoUrl       String?
  asaasPaymentId  String?
  deliveryDate    DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  cancelReason    String?
  emergencyStatus String?
  emergencyFine   Float          @default(0)
  isEmergency     Boolean        @default(false)
  rejectionReason String?
  user            User           @relation(fields: [userId], references: [id])
  history         OrderHistory[]
  items           OrderItem[]
}

model OrderHistory {
  id          String   @id @default(cuid())
  orderId     String
  statusFrom  String
  statusTo    String
  actionBy    String
  actionEmail String
  notes       String?
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model RouteSchedule {
  id          String @id @default(cuid())
  cityName    String
  deliveryDay Int
}

model Payable {
  id           String      @id @default(cuid())
  supplierName String
  barcode      String?
  receivedDate DateTime
  dueDate      DateTime
  value        Float
  status       String      @default("PENDING")
  paidDate     DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  category     String      @default("BUSINESS")
  asaasPayId   String?
  creditCardId String?
  paymentType  String      @default("BOLETO")
  pixKey       String?
  pixKeyName   String?
  pixKeyType   String?
  creditCard   CreditCard? @relation(fields: [creditCardId], references: [id])
}

model CreditCard {
  id         String    @id @default(cuid())
  name       String
  lastDigits String?
  bankName   String?
  limit      Float?
  closingDay Int?
  dueDay     Int?
  pixKey     String
  pixKeyType String    @default("CPF")
  active     Boolean   @default(true)
  color      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  payables   Payable[]
}

model PurchaseInvoice {
  id              String    @id @default(cuid())
  description     String
  imageUrl        String
  aiValue         Float?
  aiCategory      String?
  aiRawText       String?
  status          String    @default("PENDING")
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  uploadedBy      String
  invoiceDate     DateTime?
  category        String    @default("BUSINESS")
  source          String    @default("ai")
}

model MenuProduct {
  id              String              @id @default(cuid())
  name            String
  description     String
  price           Float
  imageUrl        String?
  category        String              @default("Lanches")
  active          Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  comboConfig     Json?
  isCombo         Boolean             @default(false)
  cost            Float?
  activeDelivery  Boolean             @default(true)
  activeGarcom    Boolean             @default(false)
  activePDV       Boolean             @default(true)
  activeTotem     Boolean             @default(false)
  tags            String?
  franchiseeId    String?
  comboGroups     ComboGroup[]
  comboGroupItems ComboGroupItem[]
  orderItems      CustomerOrderItem[]
  franchisee      User?               @relation(fields: [franchiseeId], references: [id])
}

model ComboGroup {
  id            String           @id @default(cuid())
  menuProductId String
  title         String
  maxQty        Int
  sortOrder     Int              @default(0)
  menuProduct   MenuProduct      @relation(fields: [menuProductId], references: [id], onDelete: Cascade)
  items         ComboGroupItem[]
}

model ComboGroupItem {
  id            String      @id @default(cuid())
  comboGroupId  String
  menuProductId String
  comboGroup    ComboGroup  @relation(fields: [comboGroupId], references: [id], onDelete: Cascade)
  menuProduct   MenuProduct @relation(fields: [menuProductId], references: [id])
}

model CustomerOrder {
  id               String              @id @default(cuid())
  franchiseeId     String
  customerName     String
  customerPhone    String
  customerAddress  String?
  deliveryType     String              @default("DELIVERY")
  totalAmount      Float
  status           String              @default("NOVO")
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  paymentMethod    String?
  customerId       String?
  deliveryFee      Float               @default(0)
  rating           Int?
  ratingComment    String?
  source           String              @default("ONLINE")
  deliveryDistance Float?
  motoboyFee       Float?
  motoboyId        String?
  pagarmeChargeId  String?
  pagarmeMethod    String?
  pagarmeOrderId   String?
  pagarmePixExpiry DateTime?
  pagarmePixQrCode String?
  pagarmeStatus    String?
  paymentPaidAt    DateTime?
  cashbackEarned   Float?
  cashbackUsed     Float?
  ifoodOrderId     String?             @unique
  ifoodReference   String?
  gatewayPaymentId String?
  gatewayProvider  String?
  customer         StoreCustomer?      @relation(fields: [customerId], references: [id])
  franchisee       User                @relation(fields: [franchiseeId], references: [id])
  motoboy          Motoboy?            @relation(fields: [motoboyId], references: [id])
  items            CustomerOrderItem[]
  review           StoreReview?
}

model CustomerOrderItem {
  id              String        @id @default(cuid())
  orderId         String
  menuProductId   String?
  quantity        Int
  price           Float
  comboSelections Json?
  menuProduct     MenuProduct?  @relation(fields: [menuProductId], references: [id])
  order           CustomerOrder @relation(fields: [orderId], references: [id])
}

model StoreCustomer {
  id              String          @id @default(cuid())
  name            String
  phone           String          @unique
  password        String
  address         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  cashbackBalance Float           @default(0)
  cashbackHistory Json?
  orders          CustomerOrder[]
  reviews         StoreReview[]
}

model StoreReview {
  id           String        @id @default(cuid())
  franchiseeId String
  customerId   String
  orderId      String        @unique
  rating       Int
  comment      String?
  createdAt    DateTime      @default(now())
  customer     StoreCustomer @relation(fields: [customerId], references: [id])
  franchisee   User          @relation(fields: [franchiseeId], references: [id])
  order        CustomerOrder @relation(fields: [orderId], references: [id])
}

model PlatformFee {
  id         String   @id @default(cuid())
  platform   String
  label      String
  feePercent Float    @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PayrollEntry {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("EMPLOYEE")
  role        String?
  amount      Float
  description String?
  payDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CashRegister {
  id            String              @id @default(cuid())
  openedAt      DateTime            @default(now())
  closedAt      DateTime?
  openingAmount Float
  status        String              @default("OPEN")
  expectedTotal Float?
  actualTotal   Float?
  discrepancy   Float?
  justification String?
  openedBy      String
  closedBy      String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  entries       CashRegisterEntry[]
}

model CashRegisterEntry {
  id             String       @id @default(cuid())
  registerId     String
  method         String
  methodLabel    String
  expectedAmount Float
  actualAmount   Float
  createdAt      DateTime     @default(now())
  register       CashRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
}

model Motoboy {
  id              String          @id @default(cuid())
  franchiseeId    String
  name            String
  phone           String?
  active          Boolean         @default(true)
  paymentType     String          @default("PER_DELIVERY")
  dailyRate       Float?
  perDeliveryRate Float?
  perKmRate       Float?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  orders          CustomerOrder[]
  franchisee      User            @relation(fields: [franchiseeId], references: [id])
}

model CashSession {
  id              String    @id @default(cuid())
  franchiseeId    String
  openedAt        DateTime  @default(now())
  closedAt        DateTime?
  status          String    @default("OPEN")
  openingAmount   Float     @default(0)
  closingCash     Float?
  closingDebit    Float?
  closingCredit   Float?
  closingPix      Float?
  closingVoucher  Float?
  closingOthers   Json?
  expectedCash    Float?
  expectedDebit   Float?
  expectedCredit  Float?
  expectedPix     Float?
  expectedVoucher Float?
  expectedTotal   Float?
  difference      Float?
  justification   String?
  closedBy        String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model FranchiseeBillingCycle {
  id              String    @id @default(cuid())
  franchiseeId    String
  yearMonth       String
  totalSales      Float     @default(0)
  planPercent     Float     @default(0)
  amountDue       Float     @default(0)
  amountOffset    Float     @default(0)
  amountPending   Float     @default(0)
  status          String    @default("OPEN")
  closedAt        DateTime?
  asaasPaymentId  String?
  asaasBoletoUrl  String?
  asaasBoletoCode String?
  asaasPixQrCode  String?
  offsetLog       Json?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  franchisee      User      @relation(fields: [franchiseeId], references: [id])

  @@unique([franchiseeId, yearMonth])
}

model MetaAdsCampaign {
  id                String    @id @default(cuid())
  franchiseeId      String
  metaCampaignId    String?
  metaAdSetId       String?
  metaAdId          String?
  metaAdCreativeId  String?
  status            String    @default("DRAFT")
  weeklyBudget      Float     @default(100)
  radiusKm          Int       @default(3)
  objective         String    @default("LINK_CLICKS")
  adCopy            String?
  adImageUrl        String?
  spend             Float     @default(0)
  impressions       Int       @default(0)
  clicks            Int       @default(0)
  ordersGenerated   Int       @default(0)
  revenue           Float     @default(0)
  managementFeePaid Float     @default(0)
  lastBilledAt      DateTime?
  depositTotal      Float     @default(0)
  depositUsed       Float     @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  franchisee        User      @relation(fields: [franchiseeId], references: [id])
}

model KitchenItem {
  id            String   @id @default(cuid())
  franchiseeId  String?
  name          String
  shelfLifeDays Int      @default(1)
  ingredients   String?
  allergens     String?
  preparation   String?
  weightStr     String?  @default("N/A")
  energy        String?  @default("0")
  carbs         String?  @default("0")
  sugars        String?  @default("0")
  addedSugars   String?  @default("0")
  proteins      String?  @default("0")
  fatTotal      String?  @default("0")
  fatSat        String?  @default("0")
  sodium        String?  @default("0")
  highSugar     Boolean  @default(false)
  highSodium    Boolean  @default(false)
  highFat       Boolean  @default(false)
  transgenic    Boolean  @default(false)
  customCnpj    String?
  customAddress String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  franchisee    User?    @relation(fields: [franchiseeId], references: [id])
}
